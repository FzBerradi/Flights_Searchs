@model Vol_Search_DotNet.Models.Vol
@using Microsoft.AspNetCore.Mvc.ModelBinding

@{
    ViewData["Title"] = "About Us";
}
<div style="background-image: url('./images/vols.jpg'); background-size: cover; background-position: center; padding: 60px; color: white; font-family: 'Arial', sans-serif; min-height: 100vh; opacity: 0.8;">
    <div class="container">
        <div style="text-align: center; margin-bottom: 40px;">
            <h1 style="margin: 0; font-size: 2.5rem;">About Us</h1>
            <p style="font-size: 1.5rem;">Discover more about our mission and services</p>
        </div>
        <div class="about-container" style="background-color: rgba(255, 255, 255, 0.1); backdrop-filter: blur(5px); padding: 40px; border-radius: 10px; color: #fff; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);">
            <div style="display: flex; flex-direction: column; align-items: center;">
                <h2 style="font-size: 2rem; margin-bottom: 20px;">Who We Are</h2>
                <p style="font-size: 1.2rem; line-height: 1.6; text-align: center; max-width: 800px;">
                    We are a team of passionate professionals dedicated to offering a seamless flight booking experience. 
                    Our platform is designed to help you search, compare, and book flights with ease, saving you time and effort.
                </p>
            </div>
            
            <div class="mission-section" style="margin-top: 40px;">
                <h2 style="font-size: 2rem; text-align: center;">Our Mission</h2>
                <p style="font-size: 1.2rem; line-height: 1.6; text-align: center; max-width: 800px;">
                    Our mission is to simplify your travel planning process by offering the best flight options with transparency, ease, and reliability. We aim to connect you with the world.
                </p>
            </div>
            
            <div class="values-section" style="margin-top: 40px;">
                <h2 style="font-size: 2rem; text-align: center;">Our Values</h2>
                <ul style="font-size: 1.2rem; line-height: 1.8; text-align: center; list-style-type: none; padding: 0; max-width: 800px; margin: 0 auto;">
                    <li><i class="fas fa-check-circle" style="color: rosybrown;"></i> Innovation</li>
                    <li><i class="fas fa-check-circle" style="color: rosybrown;"></i> Reliability</li>
                    <li><i class="fas fa-check-circle" style="color: rosybrown;"></i> Customer-Focused</li>
                    <li><i class="fas fa-check-circle" style="color: rosybrown;"></i> Integrity</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Footer section -->
<footer style="background-color: #2c3e50; color: white; padding: 40px 20px; font-family: 'Arial', sans-serif;">
    <div class="container" style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px;">
        <!-- About Section -->
        <div style="flex: 1; min-width: 250px;">
            <h3 style="margin-bottom: 10px; font-size: 1.2rem; border-bottom: 2px solid black; display: inline-block;">About Us</h3>
            <p style="line-height: 1.5;">
                We are dedicated to providing a seamless flight searching and booking experience.
            </p>
        </div>
        <!-- Quick Links -->
        <div style="flex: 1; min-width: 250px;">
            <h3 style="margin-bottom: 10px; font-size: 1.2rem; border-bottom: 2px solid white; display: inline-block;">Quick Links</h3>
            <ul style="list-style: none; padding: 0; line-height: 1.8;">
                <li><a href="/" style="color: white; text-decoration: none;">Home</a></li>
                <li><a href="/about" style="color: black; text-decoration: none;">About</a></li>
                <li><a href="/contact" style="color: black; text-decoration: none;">Contact</a></li>
                <li><a href="/privacy" style="color: black; text-decoration: none;">Privacy Policy</a></li>
            </ul>
        </div>
        <div style="flex: 1; min-width: 250px;">
            <h3 style="margin-bottom: 10px; font-size: 1.2rem; border-bottom: 2px solid black; display: inline-block;">Contact Us</h3>
            <p style="line-height: 1.5;">
                <strong>Email:</strong> support@flightsystem.com <br>
                <strong>Phone:</strong> +212 567890199 <br>
                <strong>Address:</strong> 123 Flight Street, Tetouan, Morocco
            </p>
        </div>
    </div>

    <div style="text-align: center; margin-top: 30px; border-top: 1px solid black; padding-top: 20px; font-size: 0.9rem;">
        &copy; 2024 Flight Searching System. All rights reserved.
    </div>
</footer>
