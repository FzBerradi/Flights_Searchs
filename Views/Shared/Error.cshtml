@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Development Mode</h3>
<p>
    Switching to the <strong>Development</strong> environment will show more detailed error information.
</p>
<p>
    <strong>Do not enable the Development environment for production applications.</strong>
    Doing so may expose sensitive information from errors to end users.
    For debugging locally, set the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
    and restart the application.
</p>
